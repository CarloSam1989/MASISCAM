# PROPUESTA no aplicada. Resolver __DOMINIO__, __WWW__, __CERT_NAME__.
# Contexto http (sites-available), no pegar dentro de otro server.
# En VPS Ubuntu revisar conflicto del sitio default antes de habilitar.
log_format masiscam_safe '$remote_addr - $remote_user [$time_local] '
                         '"$request_method $uri $server_protocol" $status $body_bytes_sent '
                         'rt=$request_time urt=$upstream_response_time';
limit_req_zone $binary_remote_addr zone=masiscam_login:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=masiscam_consulta:10m rate=60r/m;

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    listen [::]:80;
    server_name __DOMINIO__ __WWW__;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        try_files $uri =404;
    }
    location / { return 301 https://__DOMINIO__$request_uri; }
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __WWW__;
    ssl_certificate /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_NAME__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    return 301 https://__DOMINIO__$request_uri;
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMINIO__;
    if ($host != __DOMINIO__) { return 444; }
    ssl_certificate /etc/letsencrypt/live/__CERT_NAME__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__CERT_NAME__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:MASISCAM_TLS:10m;
    ssl_session_timeout 1d;
    server_tokens off;
    client_max_body_size 30m;
    access_log /var/log/nginx/masiscam-access.log masiscam_safe;
    error_log /var/log/nginx/masiscam-error.log warn;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;
    add_header Referrer-Policy same-origin always;
    add_header Permissions-Policy 'camera=(), microphone=(), geolocation=()' always;
    # HSTS/X-Frame/nosniff app provienen de Django; inspeccionar también respuestas edge.
    # CSP restrictiva requiere adaptar inline scripts/styles antes; no añadir a ciegas.
    limit_req_status 429;
    location = /health/ { return 404; }
    location /media/ { return 404; }
    location = /app/cuentas/login/ {
        limit_req zone=masiscam_login burst=10 nodelay;
        proxy_pass http://127.0.0.1:8080;
    }
    location = /consulta/ {
        limit_req zone=masiscam_consulta burst=20 nodelay;
        proxy_pass http://127.0.0.1:8080;
    }
    location / { proxy_pass http://127.0.0.1:8080; }
    # Los location heredan estos parámetros al no definir proxy_set_header propios.
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_connect_timeout 10s;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
}
