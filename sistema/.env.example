# DESARROLLO. Ejecutar python tools/setup_env.py --development para generar .env.
DEBUG=true
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost:8000
TIME_ZONE=America/Guayaquil
MASISCAM_PUBLIC_BASE_URL=http://localhost:8080
POSTGRES_DB=masiscam
POSTGRES_USER=masiscam
POSTGRES_PASSWORD=
# Docker sustituye DATABASE_URL automáticamente. Sin Docker, quitar esta variable para SQLite SOLO en DEBUG.
DATABASE_URL=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
MASISCAM_RELEASE=local
HTTP_PORT=127.0.0.1:8080
MASISCAM_MAX_UPLOAD_MB=25
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CREDENTIALS_FILE=/run/secrets/google-drive.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
TRUST_PROXY=false
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
