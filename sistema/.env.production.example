# PRODUCCIÓN. Ejecutar python3 tools/setup_env.py --domain __DOMINIO__.
# No ejecutar con placeholders; colocar la credencial/raíz antes de habilitar Drive.
DEBUG=false
SECRET_KEY=
ALLOWED_HOSTS=__DOMINIO__,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://__DOMINIO__
TIME_ZONE=America/Guayaquil
MASISCAM_PUBLIC_BASE_URL=https://__DOMINIO__
POSTGRES_DB=masiscam
POSTGRES_USER=masiscam
POSTGRES_PASSWORD=
# Docker sustituye DATABASE_URL automáticamente. Sin Docker, quitar esta variable para SQLite SOLO en DEBUG.
DATABASE_URL=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
MASISCAM_RELEASE=1.0.0-20260919
HTTP_PORT=127.0.0.1:8080
MASISCAM_MAX_UPLOAD_MB=25
GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_CREDENTIALS_FILE=/run/secrets/google-drive.json
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SHARED_DRIVE_ID=
TRUST_PROXY=true
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
